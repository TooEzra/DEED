// THE DEED HOSTELS - Prisma Schema
// Single-property hostel management system

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
 
}

// ─────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────

enum Role {
  ADMIN
  CARETAKER
  TENANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum HouseStatus {
  VACANT
  OCCUPIED
  MAINTENANCE
  RESERVED
}

enum TenantStatus {
  ACTIVE
  INACTIVE
  MOVED_OUT
}

enum PaymentType {
  RENT
  DEPOSIT
  UTILITY
  PENALTY
  OTHER
}

enum PaymentMethod {
  MPESA
  BANK
  CASH
  OTHER
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  CANCELLED
  REFUNDED
}

enum LeaseStatus {
  ACTIVE
  EXPIRED
  TERMINATED
  RENEWED
}

enum MaintenanceCategory {
  PLUMBING
  ELECTRICAL
  SECURITY
  CLEANING
  STRUCTURAL
  WATER
  OTHER
}

enum MaintenancePriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum MaintenanceStatus {
  PENDING
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
}

enum ExpenseCategory {
  REPAIRS
  WATER
  ELECTRICITY
  SECURITY
  CLEANING
  MAINTENANCE
  SALARIES
  SUPPLIES
  OTHER
}

enum NotificationType {
  RENT_DUE
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  RENT_OVERDUE
  MAINTENANCE_UPDATE
  LEASE_EXPIRING
  ANNOUNCEMENT
  SYSTEM
}

enum AnnouncementTarget {
  ALL_TENANTS
  ALL_USERS
  CARETAKERS
}

// ─────────────────────────────────────────────
// MODELS
// ─────────────────────────────────────────────

model User {
  id            String     @id @default(uuid())
  email         String     @unique
  phone         String?    @unique
  passwordHash  String     @map("password_hash")
  role          Role
  status        UserStatus @default(ACTIVE)
  fullName      String     @map("full_name")
  emailVerified DateTime?  @map("email_verified")
  lastLoginAt   DateTime?  @map("last_login_at")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  tenant        Tenant?
  caretaker     Caretaker?
  auditLogs     AuditLog[]
  notifications Notification[]
  recordedPayments Payment[] @relation("RecordedBy")
  expenses      Expense[]
  announcements Announcement[]
  passwordResetTokens PasswordResetToken[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model PasswordResetToken {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([token])
  @@map("password_reset_tokens")
}

model PropertySettings {
  id          String   @id @default(uuid())
  name        String   @default("THE DEED HOSTELS")
  location    String?
  phone       String?
  email       String?
  logoUrl     String?  @map("logo_url")
  description String?
  currency    String   @default("KES")
  rentDueDay  Int      @default(5) @map("rent_due_day")
  lateFeeAmount Decimal? @map("late_fee_amount") @db.Decimal(12, 2)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@map("property_settings")
}

model House {
  id            String      @id @default(uuid())
  houseNumber   String      @unique @map("house_number")
  houseType     String      @map("house_type") // Bedsitter, Single Room, 1 Bedroom, etc.
  monthlyRent   Decimal     @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount Decimal     @map("deposit_amount") @db.Decimal(12, 2)
  status        HouseStatus @default(VACANT)
  description   String?
  amenities     String[]    @default([])
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenants               Tenant[]
  payments              Payment[]
  leases                Lease[]
  maintenanceRequests   MaintenanceRequest[]

  @@index([status])
  @@index([houseType])
  @@map("houses")
}

model Tenant {
  id                     String       @id @default(uuid())
  userId                 String       @unique @map("user_id")
  fullName               String       @map("full_name")
  phone                  String
  email                  String?
  nationalId             String?      @map("national_id")
  emergencyContactName   String?      @map("emergency_contact_name")
  emergencyContactPhone  String?      @map("emergency_contact_phone")
  houseId                String?      @map("house_id")
  moveInDate             DateTime?    @map("move_in_date")
  moveOutDate            DateTime?    @map("move_out_date")
  status                 TenantStatus @default(ACTIVE)
  balance                Decimal      @default(0) @db.Decimal(12, 2)
  createdAt              DateTime     @default(now()) @map("created_at")
  updatedAt              DateTime     @updatedAt @map("updated_at")

  user                User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  house               House?               @relation(fields: [houseId], references: [id])
  payments            Payment[]
  leases              Lease[]
  maintenanceRequests MaintenanceRequest[]

  @@index([status])
  @@index([houseId])
  @@map("tenants")
}

model Caretaker {
  id        String     @id @default(uuid())
  userId    String     @unique @map("user_id")
  fullName  String     @map("full_name")
  phone     String
  email     String?
  status    UserStatus @default(ACTIVE)
  createdAt DateTime   @default(now()) @map("created_at")
  updatedAt DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("caretakers")
}

model Lease {
  id            String      @id @default(uuid())
  tenantId      String      @map("tenant_id")
  houseId       String      @map("house_id")
  startDate     DateTime    @map("start_date")
  endDate       DateTime    @map("end_date")
  monthlyRent   Decimal     @map("monthly_rent") @db.Decimal(12, 2)
  depositAmount Decimal     @map("deposit_amount") @db.Decimal(12, 2)
  status        LeaseStatus @default(ACTIVE)
  documentUrl   String?     @map("document_url")
  notes         String?
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  tenant Tenant @relation(fields: [tenantId], references: [id])
  house  House  @relation(fields: [houseId], references: [id])

  @@index([tenantId])
  @@index([houseId])
  @@index([status])
  @@index([endDate])
  @@map("leases")
}

model Payment {
  id                   String        @id @default(uuid())
  tenantId             String        @map("tenant_id")
  houseId              String        @map("house_id")
  amount               Decimal       @db.Decimal(12, 2)
  paymentType          PaymentType   @map("payment_type")
  paymentMethod        PaymentMethod @map("payment_method")
  transactionReference String?       @unique @map("transaction_reference")
  paymentDate          DateTime      @map("payment_date")
  status               PaymentStatus @default(PENDING)
  recordedById         String?       @map("recorded_by")
  notes                String?
  mpesaCheckoutRequestId String?     @map("mpesa_checkout_request_id")
  mpesaReceiptNumber   String?       @map("mpesa_receipt_number")
  receiptNumber        String?       @unique @map("receipt_number")
  createdAt            DateTime      @default(now()) @map("created_at")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  tenant     Tenant @relation(fields: [tenantId], references: [id])
  house      House  @relation(fields: [houseId], references: [id])
  recordedBy User?  @relation("RecordedBy", fields: [recordedById], references: [id])

  @@index([tenantId])
  @@index([houseId])
  @@index([status])
  @@index([paymentDate])
  @@index([paymentType])
  @@map("payments")
}

model MaintenanceRequest {
  id            String               @id @default(uuid())
  tenantId      String               @map("tenant_id")
  houseId       String               @map("house_id")
  title         String
  description   String
  category      MaintenanceCategory
  priority      MaintenancePriority  @default(MEDIUM)
  status        MaintenanceStatus    @default(PENDING)
  assignedToId  String?              @map("assigned_to")
  estimatedCost Decimal?             @map("estimated_cost") @db.Decimal(12, 2)
  actualCost    Decimal?             @map("actual_cost") @db.Decimal(12, 2)
  notes         String?
  resolvedAt    DateTime?            @map("resolved_at")
  closedAt      DateTime?            @map("closed_at")
  createdAt     DateTime             @default(now()) @map("created_at")
  updatedAt     DateTime             @updatedAt @map("updated_at")

  tenant      Tenant                   @relation(fields: [tenantId], references: [id])
  house       House                    @relation(fields: [houseId], references: [id])
  attachments MaintenanceAttachment[]

  @@index([tenantId])
  @@index([houseId])
  @@index([status])
  @@index([priority])
  @@map("maintenance_requests")
}

model MaintenanceAttachment {
  id                   String   @id @default(uuid())
  maintenanceRequestId String   @map("maintenance_request_id")
  fileUrl              String   @map("file_url")
  fileName             String   @map("file_name")
  fileType             String   @map("file_type")
  fileSize             Int      @map("file_size")
  uploadedById         String   @map("uploaded_by")
  createdAt            DateTime @default(now()) @map("created_at")

  maintenanceRequest MaintenanceRequest @relation(fields: [maintenanceRequestId], references: [id], onDelete: Cascade)

  @@index([maintenanceRequestId])
  @@map("maintenance_attachments")
}

model Expense {
  id          String          @id @default(uuid())
  category    ExpenseCategory
  description String
  amount      Decimal         @db.Decimal(12, 2)
  expenseDate DateTime        @map("expense_date")
  recordedById String         @map("recorded_by")
  receiptUrl  String?         @map("receipt_url")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  recordedBy User @relation(fields: [recordedById], references: [id])

  @@index([category])
  @@index([expenseDate])
  @@map("expenses")
}

model Announcement {
  id          String             @id @default(uuid())
  title       String
  content     String
  target      AnnouncementTarget @default(ALL_TENANTS)
  createdById String             @map("created_by")
  isActive    Boolean            @default(true) @map("is_active")
  publishedAt DateTime           @default(now()) @map("published_at")
  expiresAt   DateTime?          @map("expires_at")
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")

  createdBy User @relation(fields: [createdById], references: [id])
  reads     AnnouncementRead[]

  @@index([publishedAt])
  @@index([isActive])
  @@map("announcements")
}

model AnnouncementRead {
  id             String   @id @default(uuid())
  announcementId String   @map("announcement_id")
  userId         String   @map("user_id")
  readAt         DateTime @default(now()) @map("read_at")

  announcement Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@map("announcement_reads")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  title     String
  message   String
  link      String?
  isRead    Boolean          @default(false) @map("is_read")
  metadata  Json?
  createdAt DateTime         @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  oldValues  Json?    @map("old_values")
  newValues  Json?    @map("new_values")
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
